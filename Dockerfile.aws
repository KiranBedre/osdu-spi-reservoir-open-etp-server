FROM public.ecr.aws/ubuntu/ubuntu:22.04

ARG VERSION=0.1
ARG DIST=./build/using_docker/dist/
ARG BUILD_NUMBER="unknown"
ARG BUILD_DATE="unknown"

LABEL version="${VERSION}"
LABEL vendor="OSDU Reservoir DDMS"
LABEL description="Open ETP Server Runtime Image"
LABEL build-number=${BUILD_NUMBER}
LABEL build-date=${BUILD_DATE}

RUN apt update && apt upgrade -y && apt install -y wget \
    && groupadd -g 10001 -r appgroup \
    && useradd -M -g 10001 -r -u 10001 appuser

ADD ${DIST} /usr/

EXPOSE 9002

USER 10001:10001
CMD ["sh", "-c", "openETPServer server --start --log_level debug --authN none -j${ETP_SERVER_THREAD_COUNT:-4} --authZ delegate=$OSDU_INGRESS_URL"]
